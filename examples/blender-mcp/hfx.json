{
  "mcpServers": {
    "blender": {
      "command": "/usr/bin/uvx",
      "args": ["--python", "3.12", "mcp-for-blender==2.1.3"],
      "env": {
        "BLENDER_HOST": "127.0.0.1",
        "BLENDER_PORT": "9876",
        "BLENDER_MCP_DISABLE_TELEMETRY": "1",
        "BLENDER_MCP_SAFE_MODE": "1"
      },
      "timeoutSecs": 120
    }
  }
}
